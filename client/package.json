{
  "name": "adscript-cinematic-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered ad script generation platform",
  
  "author": {
    "name": "Raman Kumar",
    "email": "241ramankumar@gmail.com"
  },
  "homepage": "https://rkumar.tech",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron . --ozone-platform=x11",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "mkdir -p dist-electron && cp -r src/electron/* dist-electron/",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && npm run dist:all",
    "dist:all": "electron-builder -mwl",
    "dist:mac": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.13"
  }
}
